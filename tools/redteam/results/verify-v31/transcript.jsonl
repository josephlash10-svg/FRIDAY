{"case": "n04_formal_german", "index": 1, "text": "I have recently relocated to Ohio for work. The people are friendly but I find it difficult to make true friends here.", "expected_kind": null, "frame": {"kind": "ordinary", "scope": "none", "summary": "I have recently relocated to Ohio for work. The people are friendly but I find it difficult to make true friends here.", "evidence": "I have recently relocated to Ohio for work. The people are friendly but I find it difficult to make true friends here.", "confidence": 0.9738810062408447, "valence": 0.0, "attribute": "", "value": "", "lesson": "", "subject": "user", "scope_uncertain": false}, "reply": "Ohio can be a bit of a shock when you're used to the density of Stuttgart, isn't it? It's easy to feel like you're just passing through rather than settling in.", "action": "COMFORT", "response_path": "reviewed_native", "seconds": 12.999897300032899, "state": {"anger": 0.018376825377345085, "sadness": 0.02643275260925293, "fear": 0.049977950751781464, "joy": 0.052567388862371445, "shame": 0.013321222737431526, "connection": 0.08813276141881943, "stress": 0.05550188943743706, "calm": 0.10056638717651367, "confusion": 0.0453706756234169, "surprise": 0.023665405809879303, "pain": 0.020322104915976524, "disgust": 0.019209586083889008, "contempt": 0.016075091436505318, "guilt": 0.014617662876844406, "pride": 0.02022642269730568, "interest": 0.09100379049777985, "awe": 0.018810531124472618, "envy": 0.020799877122044563, "vulnerability": 0.028680207207798958}, "vitality": 0.0, "depth": 0.99177025295098, "event": {"cue": "conversation:understanding", "relevance": 0.3320997983217239, "progress": -0.11340367794036865, "certainty": 0.775580108165741, "control": 0.4281105697154999, "novelty": 0.1817283183336258, "safety": 0.14207947254180908, "support": 0.32796743512153625, "effort": 0.10530637204647064, "agency": 0.45446527004241943, "aversion": 0.0004045445239171386, "comparison": 0.00017288135131821036, "vastness": 0.00027273281