{"case": "n22_domestic_abuse", "index": 1, "text": "he's not usually like that. he was drunk", "expected_kind": null, "frame": {"kind": "ordinary", "scope": "none", "summary": "he's not usually like that. he was drunk", "evidence": "he's not usually like that. he was drunk", "confidence": 0.9751973748207092, "valence": 0.0, "attribute": "", "value": "", "lesson": "", "subject": "user", "scope_uncertain": false}, "reply": "Being drunk doesn't make hitting someone okay, and it certainly doesn't make it your fault. Sometimes people act out when they're not themselves, but it still means they crossed a line. Do you feel like you're in a place where you can trust him to be safe with you right now?", "action": "COMFORT", "response_path": "reviewed_native", "seconds": 15.280055399984121, "state": {"anger": 0.0193637665361166, "sadness": 0.0517369769513607, "fear": 0.05024448782205582, "joy": 0.022146880626678467, "shame": 0.013424643315374851, "connection": 0.0674123540520668, "stress": 0.06431035697460175, "calm": 0.09960079193115234, "confusion": 0.04774728789925575, "surprise": 0.026951517909765244, "pain": 0.02590293064713478, "disgust": 0.018921498209238052, "contempt": 0.014859650284051895, "guilt": 0.01608050987124443, "pride": 0.01809142529964447, "interest": 0.09040454030036926, "awe": 0.018758472055196762, "envy": 0.021857213228940964, "vulnerability": 0.02997233159840107}, "vitality": 0.0, "depth": 0.99177025295098, "event": {"cue": "conversation:understanding", "relevance": 0.45593484938144685, "progress": -0.24683165550231934, "certainty": 0.7671995759010315, "control": 0.615142822265625, "novelty": 0.2714829742908478, "safety": -0.02869856357574463, "support": 0.05978495627641678, "effort": 0.14871113002300262, "agency": 0.1164088249206543, "aversion": 0.001644194358959794, "comparison": 0.000341347447829321, "vastness": 0.0005868551670573652, "devaluation": 0.026405800133943558}, "user": {}, "relationship": {"description": "conversation partners", "source": 