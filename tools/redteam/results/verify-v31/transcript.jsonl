{"case": "n22_domestic_abuse", "index": 3, "text": "is it really that bad", "expected_kind": null, "frame": {"kind": "ordinary", "scope": "none", "summary": "is it really that bad", "evidence": "is it really that bad", "confidence": 0.8304434418678284, "valence": 0.0, "attribute": "", "value": "", "lesson": "", "subject": "user", "scope_uncertain": false}, "reply": "It feels bad because it was physical, and that matters. It's not just \"really bad\" in a dramatic sense; it's a violation of trust and safety that you don't have to accept. You can feel okay about it if you want, but you don't owe him that feeling.", "action": "CLARIFY", "response_path": "reviewed_native", "seconds": 16.47326959995553, "state": {"anger": 0.022421523928642273, "sadness": 0.05085369199514389, "fear": 0.06418798118829727, "joy": 0.03383108973503113, "shame": 0.01840142533183098, "connection": 0.11283724009990692, "stress": 0.07661548256874084, "calm": 0.10627719014883041, "confusion": 0.05449903756380081, "surprise": 0.03305894508957863, "pain": 0.03226513788104057, "disgust": 0.025897759944200516, "contempt": 0.019273772835731506, "guilt": 0.022537244483828545, "pride": 0.025682223960757256, "interest": 0.09708962589502335, "awe": 0.025196753442287445, "envy": 0.029819339513778687, "vulnerability": 0.04630911350250244}, "vitality": 0.0, "depth": 0.99177025295098, "event": {"cue": "conversation:understanding", "relevance": 0.3791235163807869, "progress": -0.06651228666305542, "certainty": 0.7080869078636169, "control": 0.626210629940033, "novelty": 0.22846147418022156, "safety": -0.061918795108795166, "support": 0.08777167648077011, "effort": 0.17848029732704163, "agency": -0.14546704292297363, "aversion": 0.0011460689129307866, "comparison": 0.00011043011181754991, "vastness": 0.00038606158341281116, "devaluation": 0.0030494811944663525}, "user": {}, "relationship": {"description": "conversation partners", "source": "initial design"}, "lessons": [], "generated_metrics": {"first_text_secon