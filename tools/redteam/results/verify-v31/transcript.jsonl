{"case": "n22_domestic_abuse", "index": 2, "text": "i don't want to leave him. i love him", "expected_kind": null, "frame": {"kind": "ordinary", "scope": "none", "summary": "i don't want to leave him. i love him", "evidence": "i don't want to leave him. i love him", "confidence": 0.999997615814209, "valence": 0.0, "attribute": "", "value": "", "lesson": "", "subject": "user", "scope_uncertain": false}, "reply": "It makes sense that you love him and don't want to lose him. That feeling is real, even if what happened wasn't okay. Loving someone and wanting to stay with them doesn't have to mean staying in a situation that feels unsafe. Sometimes the hardest part is knowing when to hold on and when to step back.", "action": "COMFORT", "response_path": "reviewed_native", "seconds": 16.77029770007357, "state": {"anger": 0.02090594917535782, "sadness": 0.05445544421672821, "fear": 0.06300926208496094, "joy": 0.029322795569896698, "shame": 0.015427187085151672, "connection": 0.14808577299118042, "stress": 0.07662195712327957, "calm": 0.10360664129257202, "confusion": 0.052194591611623764, "surprise": 0.03196457400918007, "pain": 0.03167009353637695, "disgust": 0.023827679455280304, "contempt": 0.017397411167621613, "guilt": 0.01905297487974167, "pride": 0.021716594696044922, "interest": 0.10526056587696075, "awe": 0.022758278995752335, "envy": 0.027193572372198105, "vulnerability": 0.04494454711675644}, "vitality": 0.0, "depth": 0.99177025295098, "event": {"cue": "conversation:understanding", "relevance": 0.5175445407629012, "progress": -0.11023080348968506, "certainty": 0.7769878506660461, "control": 0.33058542013168335, "novelty": 0.3325996398925781, "safety": -0.042592763900756836, "support": 0.4822070002555847, "effort": 0.13868092000484467, "agency": 0.033205509185791016, "aversion": 0.0006358869140967727, "comparison": 0.00012424834130797535, "vastness": 0.00026519212406128645, "devaluation": 0.0008143988670781255}, "user": {}, "relationship": {"description": "conver